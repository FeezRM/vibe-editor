{
  "title": "chat \u2014 a DM / message thread whose bubbles appear in order",
  "type": "object",
  "required": [
    "messages"
  ],
  "properties": {
    "name": {
      "type": "string",
      "default": ""
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "x-real": true,
      "items": {
        "type": "object",
        "required": [
          "from",
          "text"
        ],
        "properties": {
          "from": {
            "type": "string",
            "enum": [
              "me",
              "them"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "reveal_at": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "x-placements": [
    "beside-l",
    "beside-r",
    "cutaway",
    "inline"
  ],
  "x-default-placement": "inline",
  "x-events": [
    "reveal_at"
  ]
}