{
  "title": "list-card \u2014 a titled card whose rows appear on cue with \u2713 / \u2715 / number marks",
  "type": "object",
  "required": [
    "rows"
  ],
  "properties": {
    "title": {
      "type": "string",
      "x-real": true
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "x-real": true,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "mark": {
            "type": "string",
            "enum": [
              "check",
              "x",
              "none",
              "num"
            ]
          }
        }
      }
    },
    "reveal_at": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "one entry per row, seconds into the graphic"
    }
  },
  "x-placements": [
    "beside-l",
    "beside-r",
    "cutaway",
    "inline"
  ],
  "x-default-placement": "inline",
  "x-events": [
    "reveal_at"
  ]
}