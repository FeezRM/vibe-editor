{
  "title": "pixel-quest — a pixel-art hero dressed like the creator sprints along a ledge, punches a $ block on the spoken number, and coins spin out into an arcade counter that rolls up to the REAL value while it turns from white to green",
  "type": "object",
  "required": [
    "value",
    "source"
  ],
  "properties": {
    "value": {
      "type": "number",
      "x-real": true,
      "description": "the spoken number the counter lands on (e.g. 10000)"
    },
    "prefix": {
      "type": "string",
      "default": "$"
    },
    "digits": {
      "type": "integer",
      "default": 5,
      "description": "arcade field width; leading zeros stay dim until the count reaches them"
    },
    "unit": {
      "type": "string",
      "default": "",
      "maxLength": 6,
      "description": "small pixel suffix after the counter, e.g. /MO"
    },
    "source": {
      "type": "string",
      "x-real": true,
      "description": "where the number comes from — required by validate-plan"
    },
    "color_from": {
      "type": "string",
      "default": "#FFFFFF"
    },
    "color_to": {
      "type": "string",
      "default": "#3BFF7A"
    },
    "coin": {
      "type": "string",
      "default": "#FFC531"
    },
    "ledge": {
      "type": "string",
      "default": "#3B5590"
    },
    "coins": {
      "type": "integer",
      "default": 10,
      "minimum": 3,
      "maximum": 20
    },
    "look": {
      "type": "object",
      "description": "how the hero is dressed — set it from the creator's footage (hair, skin, shirt, logo colour, pants, shoes, glasses, beard)",
      "default": {
        "skin": "#C68A63",
        "hair": "#2A2226",
        "shirt": "#3D4452",
        "shirt_accent": "#3D4452",
        "pants": "#2E3440",
        "shoes": "#EEF1F5",
        "glasses": false,
        "beard": false
      },
      "properties": {
        "skin": {
          "type": "string"
        },
        "hair": {
          "type": "string"
        },
        "shirt": {
          "type": "string"
        },
        "shirt_accent": {
          "type": "string"
        },
        "pants": {
          "type": "string"
        },
        "shoes": {
          "type": "string"
        },
        "lens": {
          "type": "string"
        },
        "glasses": {
          "type": "boolean"
        },
        "beard": {
          "type": "boolean"
        }
      }
    },
    "reveal_at": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "[bonk (the hero punches the block — on the spoken number), land (the counter hits the value — on the unit word)]"
    }
  },
  "x-placements": [
    "top",
    "inline"
  ],
  "x-default-placement": "top",
  "x-events": [
    "reveal_at"
  ],
  "x-needs-provenance": true,
  "x-own-steps": true
}