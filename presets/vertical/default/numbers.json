{
  "$comment": "The mechanical numbers for the vertical/default preset: canvas, transcript, the cut's silence/edge handling, the caption look, audio levels, export. Taste — what to show, where, how it moves — is not a number; it comes from the samples (samples/STYLE.md).",
  "canvas": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "transcript": {
    "engine": "whisperx",
    "model": "large-v3",
    "fallback_model": "medium.en",
    "compute_type": "int8",
    "vad": "silero",
    "min_word_score": 0.3,
    "max_word_s": 2.5,
    "max_intra_segment_gap_s": 1.5,
    "min_words_per_s": 1.0,
    "clamp_word_s": 1.0,
    "gap_min_s": 1.0
  },
  "cut": {
    "min_gap_s": 0.35,
    "hold_snap_s": 0.5,
    "lead_s": 0.03,
    "tail_s": 0.02,
    "pause_max_s": 0.08,
    "pause_rel_db": 30,
    "pause_min_piece_s": 0.06,
    "breath_rel_db": 14,
    "closure_max_s": 0.09,
    "tuck_max_s": 0.3,
    "join_gap_max_s": 0.1,
    "join_quiet_db": -50,
    "pause_gate_s": 0.1,
    "min_clip_s": 0.6,
    "fillers": [
      "um",
      "uh",
      "umm",
      "uhh",
      "hmm",
      "mm",
      "erm",
      "ah"
    ],
    "keep_tics": [
      "like",
      "you know",
      "basically",
      "so",
      "i mean",
      "literally",
      "honestly"
    ],
    "min_sliver_frames": 8,
    "remove_false_starts": true,
    "remove_retakes": true,
    "retake_min_words": 3,
    "retake_window_s": 45.0,
    "retake_similar_words": 8,
    "retake_similarity": 0.75,
    "retake_protect_words": 6,
    "retake_split_gap_s": 1.0,
    "fragment_max_words": 2,
    "fragment_gap_s": 1.0,
    "coverage_max_run": 2,
    "restart_max_words": 8,
    "edge_rel_db": 32,
    "edge_search_s": 0.3,
    "mark": {
      "enabled": true,
      "at": [
        0.2,
        0.5,
        0.8
      ],
      "min_on": 2,
      "dx": 0.1,
      "dy": 0.06,
      "dw": 0.3
    }
  },
  "captions": {
    "font_family": "Inter",
    "font_file": "Inter.ttf",
    "size_px": 78,
    "hook_size_px": 104,
    "case": "lower",
    "max_words": 5,
    "min_words": 1,
    "max_width_frac": 0.78,
    "band_top": 920,
    "band_bottom": 1130,
    "line_height": 1.0,
    "tracking_em": -0.03,
    "glow": "0 0 14px rgba(0,0,0,.75), 0 4px 22px rgba(0,0,0,.6)",
    "cap_height_px": [
      44,
      70
    ],
    "colors": {
      "ink": "#FFFFFF",
      "bad": "#EB0408",
      "good": "#00E800",
      "hot": "#FFC531",
      "em": "#FFFFFF"
    },
    "chars_per_line": 19,
    "font_weight": 800,
    "accent_family": "Playfair Display",
    "accent_file": "PlayfairDisplay-Italic.ttf",
    "accent_style": "italic",
    "accent_weight": 600,
    "accent_scale": 1.2,
    "auto_accent": false
  },
  "graphics": {
    "$comment": "entrance_s: the default entrance time the kept presets animate over",
    "entrance_s": 0.35
  },
  "framing": {
    "$comment": "scale > 1 crops in once for the whole video (one fixed camera on the median face, face at face_y of the height); 1.0 = the source framing; face_w (fraction of the frame width) instead sizes the crop so the median face is that wide",
    "scale": 1.0,
    "face_y": 0.36
  },
  "pacing": {
    "$comment": "max_static_s: pacing-audit reports stretches with nothing changing longer than this (a report, not a gate); zoom_*: a hand-placed punch (pacing-audit --zoom-at); open_zoom_s: the opening zoom-out (pacing-audit --zoom-out-open)",
    "max_static_s": 2.0,
    "zoom_pct": 8,
    "zoom_dur_s": 0.12,
    "open_zoom_s": 0.25
  },
  "broll_window": {
    "cx": 640,
    "top": 24,
    "w": 440,
    "aspect": 0.8,
    "radius_px": 28,
    "stroke_px": 6,
    "stroke_color": "white",
    "badge": {
      "size_px": 34,
      "pad_px": 16,
      "inset_px": 16,
      "bg_alpha": 0.62
    }
  },
  "audio": {
    "voice_lufs": -16.0,
    "peak_dbfs": -1.5,
    "lufs_tolerance": 1.0,
    "music_db": -18.0,
    "music_hook_db": -30.0,
    "music_tail_s": 2.0,
    "sfx_db": -12.0,
    "max_sfx_per_10s": 4,
    "silence_db": -35,
    "silence_max_s": 0.45
  },
  "export": {
    "codec": "libx264",
    "crf": 18,
    "bitrate_mbps": 20,
    "audio_kbps": 320,
    "pix_fmt": "yuv420p"
  }
}
